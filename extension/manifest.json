{
  "manifest_version": 3,
  "name": "ResumePulse",
  "version": "1.0.0",
  "description": "Detects job postings and generates ATS-optimized resumes using AI.",

  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "*://*/*",
    "http://localhost:8000/*",
    "http://localhost:5500/*",
    "http://127.0.0.1:5500/*"
  ],

  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "exclude_globs": [
        "*://localhost:5500/*",
        "*://127.0.0.1:5500/*"
      ],
      "js": ["content.js"],
      "css": ["banner.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "ResumePulse"
  }
}